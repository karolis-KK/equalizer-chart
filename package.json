{
  "name": "equalizer-chart",
  "version": "1.0.0",
  "description": "A lightweight, customizable waveform / equalizer bar chart component for React.",
  "type": "module",
  "main": "./dist/equalizer-chart.cjs",
  "module": "./dist/equalizer-chart.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/equalizer-chart.js",
      "require": "./dist/equalizer-chart.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.3",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "chart",
    "equalizer",
    "waveform",
    "bar-chart",
    "react",
    "visualization",
    "audio",
    "gradient"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/equalizer-chart.git"
  }
}
